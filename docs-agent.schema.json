{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "docs-agent.schema.json",
  "title": "Unitary UI docs agent configuration",
  "description": "可配置 AI 文档更新合同。prompt 内容与确定性校验命令固定在 runner 中，不属于可配置字段；本 schema 拒绝未知字段、空 command、危险 sandbox 模式和绝对路径。",
  "type": "object",
  "additionalProperties": false,
  "required": ["enabled", "agent", "impactGlobs", "allowedWriteGlobs"],
  "properties": {
    "$schema": { "type": "string" },
    "enabled": { "type": "boolean" },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "model"],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$",
          "description": "Agent CLI 可执行名；禁止路径分隔符与 shell 元字符。"
        },
        "codexCli": {
          "type": "boolean",
          "description": "为 true 时按固定 Codex CLI 参数模板调用；为 false 时仅把固定 prompt 作为最后一个参数传给 command + subcommand（测试与第三方 CLI 使用）。"
        },
        "subcommand": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "model": { "type": "string", "minLength": 1 },
        "reasoningEffort": {
          "type": "string",
          "enum": ["minimal", "low", "medium", "high"]
        },
        "sandbox": {
          "type": "string",
          "enum": ["read-only", "workspace-write"],
          "description": "禁止任何绕过审批/沙箱的模式。"
        },
        "approvalMode": {
          "type": "string",
          "enum": ["approve-for-me"]
        },
        "ephemeral": { "type": "boolean" },
        "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 3600000 }
      }
    },
    "impactGlobs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "allowedWriteGlobs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
