{
  "$schema": "../../task.schema.json",
  "id": "docs-update",
  "version": 1,
  "description": "Synchronize bilingual human documentation and generated LLM references.",
  "promptFragments": [
    ".agents/policies/safety.md",
    ".agents/policies/git.md",
    ".agents/policies/documentation.md",
    ".agents/tasks/docs-update/prompt.md"
  ],
  "contextProvider": "docs-push",
  "impactGlobs": [
    ".agents/**",
    "src/**",
    "docs/geist/**",
    "package.json",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "CHANGELOG.en.md",
    "AGENTS.md",
    "CREDITS.md",
    "CREDITS.en.md",
    "THIRD_PARTY_NOTICES.md",
    "THIRD_PARTY_NOTICES.en.md"
  ],
  "allowedWriteGlobs": [
    "docs/geist/**",
    "docs/llm/index.json",
    "docs/llm/pages/**",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "CHANGELOG.en.md",
    "AGENTS.md",
    "CREDITS.md",
    "CREDITS.en.md",
    "THIRD_PARTY_NOTICES.md",
    "THIRD_PARTY_NOTICES.en.md"
  ],
  "validators": ["docs-corpus", "docs-contracts"]
}
