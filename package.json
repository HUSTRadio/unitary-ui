{
  "name": "@hustradio/unitary-ui",
  "version": "0.1.0",
  "description": "Unitary — 兼容 Vercel Geist 设计系统的 React 组件库，含 token 体系、排版、材质、完整组件族与字体度量探针",
  "type": "module",
  "main": "./dist/unitary-ui.cjs",
  "module": "./dist/unitary-ui.es.js",
  "types": "./dist/types/lib/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/unitary-ui.es.js",
      "require": "./dist/unitary-ui.cjs",
      "types": "./dist/types/lib/index.d.ts"
    },
    "./styles.css": "./dist/unitary-ui.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:lib": "tsc -p tsconfig.lib.json && tsc-alias -p tsconfig.lib.json && vite build --mode lib && node scripts/fix-css-font-urls.mjs",
    "lint": "oxlint",
    "test": "vitest run",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build:lib && pnpm run typecheck"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.28.0",
    "prismjs": "^1.30.0",
    "radix-ui": "^1.6.7",
    "react-mockframe": "1.1.0",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "jsdom": "^30.0.1",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.3.3",
    "tsc-alias": "^1.9.2",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vite-plus": "^0.2.8",
    "vitest": "4.1.10"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.20.0",
      "onFail": "download"
    }
  },
  "sideEffects": [
    "**/*.css"
  ],
  "keywords": [
    "geist",
    "design-system",
    "react",
    "components",
    "tailwindcss",
    "ui-kit",
    "font-metrics"
  ],
  "author": "HUSTRadio",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/HUSTRadio/unitary-ui"
  },
  "bugs": {
    "url": "https://github.com/HUSTRadio/unitary-ui/issues"
  },
  "homepage": "https://github.com/HUSTRadio/unitary-ui#readme"
}