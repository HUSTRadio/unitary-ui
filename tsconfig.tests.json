{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tests.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "module": "esnext",
    "types": ["vite/client", "node"],
    "allowArbitraryExtensions": true,
    /* 测试与审计脚本共用 scripts/lib、tests/audit 下的 .mjs 实现，需按 JS 推断其类型 */
    "allowJs": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Path aliases */
    "paths": {
      "@hustradio/unitary-ui": ["./src/lib/index.ts"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["tests", "docs/site/src"],
  "exclude": ["tests/e2e", "**/.hermes/**", "**/.superpowers/**"]
}
