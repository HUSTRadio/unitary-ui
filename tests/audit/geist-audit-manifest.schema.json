{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/HUSTRadio/geist-style-framework/tests/audit/geist-audit-manifest.schema.json",
  "title": "Geist replica audit manifest v2",
  "description": "Manifest v2 is the sole authority for acceptance policy and exact per-cell role contracts. Pending inventory entries remain valid but cannot produce acceptance evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "viewports",
    "themes",
    "allowedStatuses",
    "acceptancePolicy",
    "components"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "status": {
      "type": "string",
      "enum": ["IN_PROGRESS_NO_COMPLETION_CLAIM", "ACCEPTANCE_EVIDENCE_COMPLETE"]
    },
    "viewports": {
      "const": [
        { "width": 375, "height": 812 },
        { "width": 768, "height": 1024 },
        { "width": 1440, "height": 900 },
        { "width": 1920, "height": 1080 }
      ]
    },
    "themes": { "const": ["light", "dark"] },
    "allowedStatuses": {
      "const": ["PASS", "FAIL", "MISSING", "BLOCKED", "NOT_APPLICABLE"]
    },
    "acceptancePolicy": { "$ref": "#/definitions/acceptancePolicy" },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/component" }
    }
  },
  "definitions": {
    "acceptancePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceEpochNotBefore",
        "approvedFontMappings",
        "approvedIconMappings",
        "localSourceInputs",
        "pixelAttribution"
      ],
      "properties": {
        "evidenceEpochNotBefore": { "type": "string", "format": "date-time" },
        "approvedFontMappings": {
          "const": [
            {
              "officialPrimaryFamily": "Geist",
              "localPrimaryFamily": "HarmonyOS Sans SC"
            },
            {
              "officialPrimaryFamily": "Geist Mono",
              "localPrimaryFamily": "JetBrains Maple Mono"
            }
          ]
        },
        "approvedIconMappings": {
          "const": [
            {
              "officialIconSet": "geist",
              "localIconSet": "lucide"
            }
          ]
        },
        "localSourceInputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "pixelAttribution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["foregroundColorDistanceMax", "edgeExpansionDevicePixels"],
          "properties": {
            "foregroundColorDistanceMax": { "type": "number", "minimum": 0 },
            "edgeExpansionDevicePixels": { "const": 1 }
          }
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slug",
        "officialUrl",
        "inventoryStatus",
        "variants",
        "states",
        "selectors",
        "interaction"
      ],
      "properties": {
        "slug": { "type": "string", "minLength": 1 },
        "officialUrl": {
          "type": "string",
          "pattern": "^https://vercel\\.com/geist/"
        },
        "inventoryStatus": {
          "enum": [
            "pending_live_enumeration",
            "live_enumeration_partial",
            "live_enumeration_complete"
          ]
        },
        "variants": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "states": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "demos": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id"],
            "properties": {
              "id": { "type": "string", "minLength": 1 }
            }
          }
        },
        "viewports": {
          "const": ["375x812", "768x1024", "1440x900", "1920x1080"]
        },
        "themes": { "const": ["light", "dark"] },
        "interactionRecipes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "responsiveExpectations": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "selectors": { "$ref": "#/definitions/componentSelectors" },
        "interaction": { "enum": ["applicable", "NOT_APPLICABLE", "pending"] },
        "acceptanceContracts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/acceptanceContract" }
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": { "inventoryStatus": { "const": "pending_live_enumeration" } },
            "required": ["inventoryStatus"]
          },
          "then": {
            "type": "object",
            "properties": { "acceptanceContracts": false }
          },
          "else": {
            "type": "object",
            "required": [
              "demos",
              "viewports",
              "themes",
              "interactionRecipes",
              "responsiveExpectations"
            ],
            "properties": {
              "demos": {},
              "viewports": {},
              "themes": {},
              "interactionRecipes": {},
              "responsiveExpectations": {},
              "selectors": { "$ref": "#/definitions/liveComponentSelectors" }
            }
          }
        }
      ]
    },
    "componentSelectors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["official", "local"],
      "properties": {
        "official": { "$ref": "#/definitions/concreteSelector" },
        "local": { "$ref": "#/definitions/concreteSelector" }
      }
    },
    "liveComponentSelectors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["official", "local"],
      "properties": {
        "official": { "$ref": "#/definitions/liveComponentSelector" },
        "local": { "$ref": "#/definitions/liveComponentSelector" }
      }
    },
    "liveComponentSelector": {
      "allOf": [{ "$ref": "#/definitions/concreteSelector" }, { "not": { "const": "main" } }]
    },
    "acceptanceContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "demoId",
        "variant",
        "state",
        "clipRole",
        "evidenceNotBefore",
        "roles",
        "semanticNodeInventory",
        "transparentWrappers"
      ],
      "properties": {
        "demoId": { "type": "string", "minLength": 1 },
        "variant": { "type": "string", "minLength": 1 },
        "state": { "type": "string", "minLength": 1 },
        "clipRole": { "type": "string", "minLength": 1 },
        "evidenceNotBefore": { "type": "string", "format": "date-time" },
        "roles": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "additionalProperties": { "$ref": "#/definitions/roleContract" }
        },
        "semanticNodeInventory": {
          "type": "array",
          "items": { "$ref": "#/definitions/semanticNodeInventoryEntry" }
        },
        "transparentWrappers": {
          "type": "array",
          "items": { "$ref": "#/definitions/transparentWrapper" }
        }
      }
    },
    "roleContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selectors", "presence", "acceptanceProfile"],
      "properties": {
        "selectors": { "$ref": "#/definitions/roleSelectors" },
        "presence": { "enum": ["required", "forbidden"] },
        "acceptanceProfile": {
          "enum": [
            "strict",
            "mapped-text",
            "text-adjacent-icon",
            "text-sized-control",
            "measurement-context",
            "context-owned-fill"
          ]
        },
        "coordinateOwnerRole": { "type": "string", "minLength": 1 },
        "textRole": { "type": "string", "minLength": 1 },
        "flowAnchorRole": { "type": "string", "minLength": 1 },
        "contextOwnerRole": { "type": "string", "minLength": 1 },
        "anchorEdge": { "enum": ["left", "right"] },
        "measurementAxes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["x", "width", "right"] }
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": { "presence": { "const": "forbidden" } },
            "required": ["presence"]
          },
          "then": {
            "type": "object",
            "properties": { "acceptanceProfile": { "const": "strict" } },
            "propertyNames": {
              "enum": ["selectors", "presence", "acceptanceProfile"]
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": { "acceptanceProfile": { "const": "strict" } },
            "required": ["acceptanceProfile"]
          },
          "then": {
            "type": "object",
            "propertyNames": {
              "enum": ["selectors", "presence", "acceptanceProfile", "coordinateOwnerRole"]
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": { "acceptanceProfile": { "const": "mapped-text" } },
            "required": ["acceptanceProfile"]
          },
          "then": {
            "type": "object",
            "propertyNames": {
              "enum": [
                "selectors",
                "presence",
                "acceptanceProfile",
                "coordinateOwnerRole",
                "flowAnchorRole",
                "anchorEdge"
              ]
            },
            "oneOf": [
              {
                "properties": {
                  "flowAnchorRole": false,
                  "anchorEdge": false
                }
              },
              {
                "properties": { "flowAnchorRole": {}, "anchorEdge": {} },
                "required": ["flowAnchorRole", "anchorEdge"]
              }
            ]
          }
        },
        {
          "if": {
            "type": "object",
            "properties": { "acceptanceProfile": { "const": "text-adjacent-icon" } },
            "required": ["acceptanceProfile"]
          },
          "then": {
            "type": "object",
            "propertyNames": {
              "enum": [
                "selectors",
                "presence",
                "acceptanceProfile",
                "coordinateOwnerRole",
                "textRole",
                "anchorEdge"
              ]
            },
            "properties": { "textRole": {}, "anchorEdge": {} },
            "required": ["textRole", "anchorEdge"]
          }
        },
        {
          "if": {
            "type": "object",
            "properties": { "acceptanceProfile": { "const": "text-sized-control" } },
            "required": ["acceptanceProfile"]
          },
          "then": {
            "type": "object",
            "propertyNames": {
              "enum": [
                "selectors",
                "presence",
                "acceptanceProfile",
                "coordinateOwnerRole",
                "textRole"
              ]
            },
            "properties": { "textRole": {} },
            "required": ["textRole"]
          }
        },
        {
          "if": {
            "type": "object",
            "properties": { "acceptanceProfile": { "const": "measurement-context" } },
            "required": ["acceptanceProfile"]
          },
          "then": {
            "type": "object",
            "propertyNames": {
              "enum": [
                "selectors",
                "presence",
                "acceptanceProfile",
                "coordinateOwnerRole",
                "measurementAxes"
              ]
            },
            "properties": { "measurementAxes": {} },
            "required": ["measurementAxes"]
          }
        },
        {
          "if": {
            "type": "object",
            "properties": { "acceptanceProfile": { "const": "context-owned-fill" } },
            "required": ["acceptanceProfile"]
          },
          "then": {
            "type": "object",
            "propertyNames": {
              "enum": [
                "selectors",
                "presence",
                "acceptanceProfile",
                "coordinateOwnerRole",
                "contextOwnerRole"
              ]
            },
            "properties": { "contextOwnerRole": {} },
            "required": ["contextOwnerRole"]
          }
        }
      ]
    },
    "roleSelectors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default", "byViewport"],
      "properties": {
        "default": { "$ref": "#/definitions/sourceSelectorPair" },
        "byViewport": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^(375x812|768x1024|1440x900|1920x1080)$": {
              "$ref": "#/definitions/sourceSelectorPair"
            }
          }
        }
      }
    },
    "sourceSelectorPair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["official", "local"],
      "properties": {
        "official": { "$ref": "#/definitions/concreteSelector" },
        "local": { "$ref": "#/definitions/concreteSelector" }
      }
    },
    "concreteSelector": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!.*\\[LIVE_SELECTOR\\])(?=.*\\S).+$"
    },
    "semanticNodeInventoryEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["matcher", "expectedCount"],
      "properties": {
        "matcher": { "$ref": "#/definitions/semanticNodeMatcher" },
        "expectedCount": { "type": "integer", "minimum": 0 }
      }
    },
    "semanticNodeMatcher": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "tagName": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "role": { "type": "string", "minLength": 1 },
        "attributes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string" }
        },
        "presentAttributes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "attributeNamePrefix": { "type": "string", "minLength": 1 }
      }
    },
    "transparentWrapper": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "selector", "parentRole", "constraints"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "source": { "enum": ["official", "local"] },
        "selector": { "$ref": "#/definitions/concreteSelector" },
        "parentRole": { "type": "string", "minLength": 1 },
        "constraints": {
          "const": {
            "uniqueMatch": true,
            "noNativeInteraction": true,
            "noSemanticAttributes": true,
            "noInteractiveAttributes": true,
            "noBoxGeometry": true,
            "noVisibleStyle": true,
            "noPseudoContent": true
          }
        }
      }
    }
  }
}
