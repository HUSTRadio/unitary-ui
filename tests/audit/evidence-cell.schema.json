{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/HUSTRadio/unitary-ui/tests/audit/evidence-cell.schema.json",
  "title": "Geist resolved evidence cell v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "source",
    "slug",
    "demoId",
    "variant",
    "state",
    "theme",
    "viewport",
    "viewportText",
    "url",
    "rootSelector",
    "roleSelectors",
    "auditRunId",
    "contractDigest",
    "effectiveEvidenceNotBefore",
    "contract",
    "navigationStartedAt",
    "stateStabilizedAt",
    "capturedAt",
    "producer",
    "artifacts",
    "localRevision",
    "worktreeClean",
    "localSourceDigest",
    "localSourceFiles",
    "observedTheme",
    "status"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "source": { "enum": ["official", "local"] },
    "slug": { "type": "string", "minLength": 1 },
    "demoId": { "type": "string", "minLength": 1 },
    "variant": { "type": "string", "minLength": 1 },
    "state": { "type": "string", "minLength": 1 },
    "theme": { "enum": ["light", "dark"] },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "viewportText": { "type": "string", "pattern": "^[1-9][0-9]*x[1-9][0-9]*$" },
    "url": { "type": "string", "minLength": 1 },
    "rootSelector": { "type": "string", "minLength": 1 },
    "roleSelectors": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "auditRunId": { "type": "string", "minLength": 1 },
    "contractDigest": { "$ref": "#/definitions/sha256" },
    "effectiveEvidenceNotBefore": { "type": "string", "format": "date-time" },
    "contract": {
      "$ref": "geist-audit-manifest.schema.json#/definitions/acceptanceContract"
    },
    "navigationStartedAt": { "type": "string", "format": "date-time" },
    "stateStabilizedAt": { "type": "string", "format": "date-time" },
    "capturedAt": { "type": "string", "format": "date-time" },
    "sourceTimestamp": {
      "anyOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }]
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["collectorSha256", "browserVersion"],
      "properties": {
        "collectorSha256": { "$ref": "#/definitions/sha256" },
        "browserVersion": { "type": "string", "minLength": 1 }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["screenshot", "metrics"],
      "properties": {
        "screenshot": { "const": "screenshot.png" },
        "metrics": { "const": "metrics.json" }
      }
    },
    "localRevision": {
      "anyOf": [{ "$ref": "#/definitions/revision" }, { "type": "null" }]
    },
    "worktreeClean": { "type": ["boolean", "null"] },
    "localSourceDigest": {
      "anyOf": [{ "$ref": "#/definitions/sha256" }, { "type": "null" }]
    },
    "localSourceFiles": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "observedTheme": { "type": "object" },
    "status": { "const": "captured" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "source": { "const": "local" } },
        "required": ["source"]
      },
      "then": {
        "properties": {
          "localRevision": { "$ref": "#/definitions/revision" },
          "worktreeClean": { "const": true },
          "localSourceDigest": { "$ref": "#/definitions/sha256" },
          "localSourceFiles": { "type": "array", "minItems": 1 }
        }
      },
      "else": {
        "properties": {
          "localRevision": { "type": "null" },
          "worktreeClean": { "type": "null" },
          "localSourceDigest": { "type": "null" },
          "localSourceFiles": { "type": "array", "maxItems": 0 }
        }
      }
    }
  ],
  "definitions": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
  }
}
