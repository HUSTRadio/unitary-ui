{
  "$schema": "./docs-agent.schema.json",
  "enabled": true,
  "agent": {
    "command": "codex",
    "codexCli": true,
    "subcommand": ["exec"],
    "model": "gpt-5.6-terra",
    "reasoningEffort": "high",
    "approvalMode": "approve-for-me",
    "ephemeral": true,
    "timeoutMs": 1800000
  },
  "impactGlobs": [
    "src/**",
    "docs/geist/**",
    "package.json",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "CHANGELOG.en.md",
    "AGENTS.md",
    "CREDITS.md",
    "CREDITS.en.md",
    "THIRD_PARTY_NOTICES.md",
    "THIRD_PARTY_NOTICES.en.md"
  ],
  "allowedWriteGlobs": [
    "docs/geist/**",
    "docs/llm/index.json",
    "docs/llm/pages/**",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "CHANGELOG.en.md",
    "AGENTS.md",
    "CREDITS.md",
    "CREDITS.en.md",
    "THIRD_PARTY_NOTICES.md",
    "THIRD_PARTY_NOTICES.en.md"
  ],
  "validationCommands": []
}
